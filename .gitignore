.venv/
__pycache__/
*.pyc

# Raw dataset (~200 MB) - re-fetch with: python src/download_data.py
data/raw/
# ...except the two small files the dashboard needs to run in the cloud
!data/raw/L-TOWN.inp
!data/raw/dataset_configuration.yaml

# Derived caches - regenerate with: python run_all.py, but keep them so the
# deployed dashboard works without the raw dataset
!data/processed/

# EPANET scratch files
temp.bin
temp.inp
temp.rpt
*.rpt

# LeakDB Hanoi benchmark (79 MB zip, 508 MB extracted)
# re-fetch with: python src/download_leakdb.py
data/leakdb/
data/leakdb_raw/

# Per-scenario caches rebuilt from the raw LeakDB data (80 MB).
# The small derived files beside them (residuals_*, library_*) are kept,
# so the results can be inspected without the raw dataset.
data/processed/leakdb/pressures_*.csv
data/processed/leakdb/flows_*.csv
